<layer width="1640" height="900" background="#101114" color="#f4efe6" font-family="ChillDuanSans" safe="0">
  <layer camera="1600" width="1640" height="900">
    <sphere cx="150" cy="300" r="70" fill="#2a6fbe" material="plastic" />
    <sphere cx="390" cy="300" r="70" fill="#2a6fbe" material="plastic 0.4" />
    <sphere cx="710" cy="300" r="70" fill="#e4b33a" material="metal" />
    <sphere cx="950" cy="300" r="70" fill="#e4b33a" material="metal 0.28" />
    <sphere cx="1270" cy="300" r="70" fill="#e4b33a" material="mirror" />
    <sphere cx="1510" cy="300" r="70" fill="#e4b33a" material="metal 0.08" />

    <sphere cx="150" cy="640" r="70" fill="#c45a3a" material="clay" />
    <sphere cx="390" cy="640" r="70" fill="#c45a3a" />
    <sphere cx="710" cy="640" r="70" fill="#c86a3e" material="brushed" />
    <sphere cx="950" cy="640" r="70" fill="#c86a3e" material="metal 0.5" />
    <sphere cx="1270" cy="640" r="70" fill="#f7f4ee" material="glass 0.08" />
    <sphere cx="1510" cy="640" r="70" fill="#f7f4ee" material="glass 0.7" />
  </layer>

  <layer x="64" y="28" anchor-box="ink">
    <p style="font-size:40px">同一个颜色</p>
  </layer>
  <layer x="64" y="84">
    <p style="font-size:28px; color:#e8e2d8">每对填充相同</p>
  </layer>

  <layer x="90" y="390" width="140"><p style="font-size:26px; color:#e8e2d8">plastic</p></layer>
  <layer x="290" y="390" width="190"><p style="font-size:26px; color:#e8e2d8">plastic 0.4</p></layer>
  <layer x="650" y="390" width="120"><p style="font-size:26px; color:#e8e2d8">metal</p></layer>
  <layer x="850" y="390" width="190"><p style="font-size:26px; color:#e8e2d8">metal 0.28</p></layer>
  <layer x="1200" y="390" width="140"><p style="font-size:26px; color:#e8e2d8">mirror</p></layer>
  <layer x="1400" y="390" width="190"><p style="font-size:26px; color:#e8e2d8">metal 0.08</p></layer>

  <layer x="100" y="730" width="110"><p style="font-size:26px; color:#e8e2d8">clay</p></layer>
  <layer x="340" y="730" width="110"><p style="font-size:26px; color:#e8e2d8">磨砂</p></layer>
  <layer x="630" y="730" width="160"><p style="font-size:26px; color:#e8e2d8">brushed</p></layer>
  <layer x="860" y="730" width="180"><p style="font-size:26px; color:#e8e2d8">metal 0.5</p></layer>
  <layer x="1170" y="730" width="190"><p style="font-size:26px; color:#e8e2d8">glass 0.08</p></layer>
  <layer x="1420" y="730" width="170"><p style="font-size:26px; color:#e8e2d8">glass 0.7</p></layer>
</layer>
