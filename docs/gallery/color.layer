<layer width="1080" height="1500" background="#12161c" color="#e8e4dc" font-family="Kai" x="0" y="0">
  
  
  <rect x="0" y="0" width="1080" height="1500" fill="#12161c" />
  
  
  <layer x="80" y="40">
    
    
    <h1 style="font-size:48px; color:#f2ebe0">
      调色
    </h1>
    
  
  </layer>
  

  
  <rect width="260" height="150" rx="16" fill="#e85d4c" filter="grayscale(1)" x="90" y="165" />
  
  
  <rect width="260" height="150" rx="16" fill="#3ecfc4" filter="saturate(1.8) contrast(1.15)" x="410" y="165" />
  
  
  <layer x="134.98" y="340">
    <p style="font-size:24px; color:#9aa7b5">
      filter grayscale
    </p>
  </layer>
  
  
  <layer x="461.735" y="340">
    <p style="font-size:24px; color:#9aa7b5">
      filter saturate
    </p>
  </layer>
  

  
  <layer width="260" height="150" overlay="#00000066" x="90" y="445">
    
    
    <rect width="260" height="150" rx="16" fill="#f4efe4" x="0" y="0" />
    
  
  </layer>
  
  
  <layer width="260" height="150" overlay="#ff8800 0.45 multiply" x="410" y="445">
    
    
    <rect width="260" height="150" rx="16" fill="#3ecfc4" x="0" y="0" />
    
  
  </layer>
  
  
  <layer width="260" height="150" overlay="linear-gradient(to bottom, #ffffff00, #1a2430cc) soft-light" x="730" y="445">
    
    
    <rect width="260" height="150" rx="16" fill="#6aa1ff" x="0" y="0" />
    
  
  </layer>
  
  
  <layer x="151.445" y="620">
    <p style="font-size:24px; color:#9aa7b5">
      overlay 纯色
    </p>
  </layer>
  
  
  <layer x="451.92" y="620">
    <p style="font-size:24px; color:#9aa7b5">
      overlay multiply
    </p>
  </layer>
  
  
  <layer x="791.445" y="620">
    <p style="font-size:24px; color:#9aa7b5">
      overlay 渐变
    </p>
  </layer>
  

  
  <layer width="260" height="150" grade="lomo" x="70" y="785">
    
    
    <img src="scene.png" alt="风景" style="width:260px; height:150px; object-fit:cover; border-radius:16px" />
    
  
  </layer>
  
  
  <layer width="260" height="150" grade="matte" x="410" y="785">
    
    
    <img src="scene.png" alt="风景" style="width:260px; height:150px; object-fit:cover; border-radius:16px" />
    
  
  </layer>
  
  
  <layer width="260" height="150" grade="chrome" x="750" y="785">
    
    
    <img src="scene.png" alt="风景" style="width:260px; height:150px; object-fit:cover; border-radius:16px" />
    
  
  </layer>
  
  
  <layer x="136.93" y="960">
    <p style="font-size:24px; color:#9aa7b5">
      grade lomo
    </p>
  </layer>
  
  
  <layer x="471.515" y="960">
    <p style="font-size:24px; color:#9aa7b5">
      grade matte
    </p>
  </layer>
  
  
  <layer x="801.735" y="960">
    <p style="font-size:24px; color:#9aa7b5">
      grade chrome
    </p>
  </layer>
  

  
  <layer width="260" height="150" grade="bleach" x="70" y="1125">
    
    
    <img src="scene.png" alt="风景" style="width:260px; height:150px; object-fit:cover; border-radius:16px" />
    
  
  </layer>
  
  
  <layer width="260" height="150" grade="mono" x="410" y="1125">
    
    
    <img src="scene.png" alt="风景" style="width:260px; height:150px; object-fit:cover; border-radius:16px" />
    
  
  </layer>
  
  
  <layer width="260" height="150" grade="lomo" grade-mask="radial-gradient(#fff0 35%, #fff)" x="750" y="1125">
    
    
    <img src="scene.png" alt="风景" style="width:260px; height:150px; object-fit:cover; border-radius:16px" />
    
  
  </layer>
  
  
  <layer x="126.5" y="1300">
    <p style="font-size:24px; color:#9aa7b5">
      grade bleach
    </p>
  </layer>
  
  
  <layer x="473.03" y="1300">
    <p style="font-size:24px; color:#9aa7b5">
      grade mono
    </p>
  </layer>
  
  
  <layer x="814.435" y="1300">
    <p style="font-size:24px; color:#9aa7b5">
      grade-mask
    </p>
  </layer>
  

</layer>
