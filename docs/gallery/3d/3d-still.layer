<layer width="880" height="636" background="#241f1b" color="#f4efe6" font-family="ChillDuanSans" min-font="16" safe="0">
  <layer x="28" y="16"><p style="font-size:28px">静物 · studio · draft</p></layer>
  <layer x="28" y="600"><p style="font-size:18px; color:#b7aea2">贴地接触 · 悬空软影 · 缝里的遮挡 · 铬球 · 玻璃和色条 · 洞 · 霓虹 · 灯</p></layer>
  <layer x="0" y="52" width="880" height="540" camera="fov 30, orbit 28 34, distance 1100, at 500 600 0">
    <ground id="ground" y="530" rotateX="90" fill="#e7e0d4" shadow-blur="168" shadow-opacity="0.26" />
    <layer x="70" y="530" width="960" height="400" origin="480 0" rotateX="90" preserve-3d>
      <rect id="plinth" x="90" y="8" width="740" height="12" depth="170" rx="3" fill="#f6f2ea" />
      <rect id="red-box" x="70" y="48" width="190" height="130" depth="100" rx="18" fill="#d23b3b" material="plastic 0.28" />
      <rect id="white-box" x="276" y="40" width="150" height="140" depth="180" rx="12" fill="#f4f1ea" />
      <rect id="metal-plate" x="470" y="64" width="250" height="150" depth="26" rx="16" z="4" fill="#c2c8d0" material="finish metal, color #c2c8d0, roughness 0.56, metalness 0.48, clearcoat 0" />
      <sphere id="chrome" cx="590" cy="140" r="48" z="61" fill="#c5ccd3" material="metal 0.45" />
      <sphere id="blue-float" cx="160" cy="200" r="34" z="140" fill="#2a6fbe" material="plastic 0.42" />
      <rect id="stripe-red" x="178" y="200" width="70" height="28" depth="120" fill="#e23b2f" />
      <rect id="stripe-white" x="178" y="236" width="70" height="28" depth="120" fill="#e8e4dc" />
      <rect id="stripe-blue" x="178" y="272" width="70" height="28" depth="120" fill="#2a6fbe" />
      <circle id="glass" cx="190" cy="250" r="40" depth="6" z="4" fill="#ffffff33" material="glass 0.12" />
      <rect id="gold" x="744" y="88" width="76" height="98" depth="60" rx="10" fill="#e8a84a" material="plastic 0.55" />
      <layer x="400" y="230">
        <path id="hole" d="M0 0 H120 V84 H0 Z M28 18 V66 H92 V18 Z" depth="14" fill="#1f8a5b" material="plastic 0.3" />
      </layer>
      <torus id="neon" cx="352" cy="300" r="40" tube="10" z="12" fill="#3ad8ff" material="neon" rotateX="0" />
      <sphere id="lamp" cx="800" cy="55" r="20" z="150" material="lamp" />
    </layer>
  </layer>
</layer>
