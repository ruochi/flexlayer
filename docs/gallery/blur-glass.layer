<layer width="1080" height="1180" background="#0a0e14" color="#f4f1ea" font-family="Kai" x="0" y="0">
  
  
  <rect x="0" y="0" width="1080" height="1180" fill="linear-gradient(to bottom, #121826, #1a3348 45%, #243c38)" />
  
  
  
  <rect x="0" y="200" width="1080" height="16" fill="#ffffff" opacity="0.9" />
  
  
  <rect x="0" y="260" width="1080" height="16" fill="#f5c16c" />
  
  
  <rect x="0" y="320" width="1080" height="16" fill="#7b6cff" />
  
  
  <rect x="160" y="160" width="16" height="200" fill="#ffffff" opacity="0.75" />
  
  
  <rect x="520" y="160" width="16" height="200" fill="#ff9f1c" opacity="0.9" />
  
  
  <rect x="880" y="160" width="16" height="200" fill="#3ecfc4" />
  

  
  <rect x="0" y="620" width="1080" height="16" fill="#ffffff" opacity="0.9" />
  
  
  <rect x="0" y="700" width="1080" height="16" fill="#ff9f1c" />
  
  
  <rect x="0" y="780" width="1080" height="16" fill="#3ecfc4" />
  
  
  <rect x="0" y="860" width="1080" height="16" fill="#ffffff" opacity="0.85" />
  
  
  <rect x="180" y="560" width="16" height="340" fill="#ffffff" opacity="0.7" />
  
  
  <rect x="520" y="560" width="16" height="340" fill="#ff5aa5" opacity="0.85" />
  
  
  <rect x="860" y="560" width="16" height="340" fill="#f5c16c" />
  

  
  <layer x="64" y="36">
    
    
    <h1 style="font-size:48px; color:#f7f2e8">
      模糊与玻璃
    </h1>
    
  
  </layer>
  

  
  <rect width="240" height="140" rx="20" fill="#f7931a" blur="6" x="80" y="230" />
  
  
  <layer x="175.87" y="400">
    <p style="font-size:26px; color:#9aa7b5">
      blur
    </p>
  </layer>
  

  
  <rect width="240" height="140" rx="20" fill="#ffffff22" backdrop-blur="16" x="420" y="230" />
  
  
  <layer x="455.07" y="400">
    <p style="font-size:26px; color:#9aa7b5">
      backdrop-blur
    </p>
  </layer>
  

  
  <rect width="240" height="140" rx="24" fill="#ffffff14" glass="clear, blur 8, tint #a8c8ff55" x="740" y="230" />
  
  
  <layer x="771.755" y="400">
    <p style="font-size:26px; color:#9aa7b5">
      glass 逗号写法
    </p>
  </layer>
  

  
  <rect width="280" height="300" rx="28" fill="#ffffff18" glass="clear" x="60" y="610" />
  
  
  <rect width="280" height="300" rx="28" fill="#ffffff18" glass="regular" x="400" y="610" />
  
  
  <rect width="280" height="300" rx="28" fill="#ffffff20" glass="thick" x="720" y="610" />
  
  
  <layer x="133.32" y="940">
    <p style="font-size:26px; color:#f4f1ea">
      glass clear
    </p>
  </layer>
  
  
  <layer x="459.41" y="940">
    <p style="font-size:26px; color:#f4f1ea">
      glass regular
    </p>
  </layer>
  
  
  <layer x="794.49" y="940">
    <p style="font-size:26px; color:#f4f1ea">
      glass thick
    </p>
  </layer>
  

</layer>
