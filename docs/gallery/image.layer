<layer width="1080" height="520" background="#12161c" color="#e8e4dc" font-family="Kai" x="0" y="0">
  
  
  <layer x="80" y="36">
    
    
    <h1 style="font-size:48px; color:#f2ebe0">
      图片 object-fit
    </h1>
    
  
  </layer>
  
  
  <layer x="50" y="140">
    
    
