      <rect x="520" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="580" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="640" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="700" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="760" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="820" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="880" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="940" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="1000" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="1060" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="1120" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="1180" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="1240" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="1300" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="1360" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="1420" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />

      <sphere cx="230" cy="240" r="72" z="72" fill="#f7f4ee" material="glass 0.72" />
      <rect x="520" y="200" width="150" height="150" depth="130" rx="34" z="65" fill="#f7f4ee" material="glass 0.72" rotateY="-22" rotateX="18" />
      <rect x="900" y="200" width="150" height="150" depth="130" z="65" fill="#f7f4ee" material="glass 0.72" rotateY="-20" rotateX="16" />
      <model x="1280" y="175" width="190" height="200" src="diamond.glb" material="glass 0.72" rotateY="-28" rotateX="36" z="60" />
    </layer>
  </layer>

  <layer x="150" y="468" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; width:200px">
      <p style="font-size:26px">球</p>
    </div>
  </layer>
  <layer x="500" y="468" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; width:200px">
      <p style="font-size:26px">圆角正方</p>
    </div>
  </layer>
  <layer x="850" y="468" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; width:200px">
      <p style="font-size:26px">正方</p>
    </div>
  </layer>
  <layer x="1200" y="468" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; width:200px">
      <p style="font-size:26px">钻石</p>
    </div>
  </layer>
</layer>
