<layer width="1520" height="1000" background="#101114" color="#f4efe6" font-family="ChillDuanSans" safe="0">
  <layer x="64" y="24">
    <p style="font-size:40px">假玻璃</p>
  </layer>
  <layer x="64" y="78">
    <p style="font-size:28px; color:#c8c2b6">反射留着主灯，折射再叠这张环境 · 两组只差粗糙度</p>
  </layer>

  <!-- Two rows, one camera each: on a single perspective floor the near row
       covers the far one.

       Glass in front of the bare page transmits the page and reads as opaque
       grey (§C.1), so each row has a striped wall behind the bodies. The wall
       is one line of tall cards along the back of the floor and the bodies
       stand well in front of it, so every base has open floor in front and its
       own contact shadow is readable (§C.2) — a card the bodies stood against
       would put its own projected base under theirs. -->
  <layer x="0" y="112" width="1520" height="392" camera="fov 30, orbit 18 20, distance 1750, at 760 470 0">
    <ground y="330" rotateX="90" fill="#2a2d36" shadow-blur="34" shadow-opacity="0.55" />
    <layer x="0" y="330" width="1520" height="420" origin="760 0" rotateX="90" preserve-3d>
      <!-- the wall: 24 cards, 60 wide, standing 210 tall -->
      <rect x="40" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="100" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="160" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="220" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="280" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="340" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="400" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="460" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="520" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="580" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="640" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="700" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="760" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="820" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="880" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="940" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="1000" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="1060" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="1120" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="1180" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="1240" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />
      <rect x="1300" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="1360" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
      <rect x="1420" y="0" width="60" height="24" depth="210" z="105" fill="#2a6fbe" />

      <sphere cx="230" cy="240" r="72" z="72" fill="#f7f4ee" material="glass 0.08" />
      <rect x="520" y="200" width="150" height="150" depth="130" rx="34" z="65" fill="#f7f4ee" material="glass 0.08" rotateY="-22" rotateX="18" />
      <rect x="900" y="200" width="150" height="150" depth="130" z="65" fill="#f7f4ee" material="glass 0.08" rotateY="-20" rotateX="16" />
      <model x="1280" y="175" width="190" height="200" src="diamond.glb" material="glass 0.08" rotateY="-28" rotateX="36" z="60" />
    </layer>
  </layer>

  <layer x="64" y="512">
    <p style="font-size:26px; color:#c8c2b6">同一组形体 · 粗糙 0.72</p>
  </layer>

  <layer x="0" y="556" width="1520" height="392" camera="fov 30, orbit 18 20, distance 1750, at 760 470 0">
    <ground y="330" rotateX="90" fill="#2a2d36" shadow-blur="34" shadow-opacity="0.55" />
    <layer x="0" y="330" width="1520" height="420" origin="760 0" rotateX="90" preserve-3d>
      <rect x="40" y="0" width="60" height="24" depth="210" z="105" fill="#e23b2f" />
      <rect x="100" y="0" width="60" height="24" depth="210" z="105" fill="#f7f4ee" />
