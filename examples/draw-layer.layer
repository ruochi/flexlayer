<layer width="720" height="480" background="#0f1115" color="#f4f1ea" x="0" y="0">
  <layer x="40" y="36">
    <h1 style="font-size:42px">layer + canvas</h1>
  </layer>
  <layer x="40" y="96">
    <p style="font-size:22px; color:#9aa3b2">嵌套 layer 不填背景，色块用 rect 或 canvas</p>
  </layer>
  <rect width="200" height="120" rx="16" fill="#1c2430" x="48" y="168" />
  <layer x="48" y="200">
    <p style="font-size:20px; color:#9aa3b2">Rect fill</p>
  </layer>
  <layer width="200" height="120" x="296" y="228">
    <canvas id="grad" width="200" height="120"></canvas>
    <script>
      const canvas = document.querySelector('#grad')
      const ctx = canvas.getContext('2d')
      const g = ctx.createLinearGradient(0, 0, canvas.width, canvas.height)
      g.addColorStop(0, '#3ecfc4')
      g.addColorStop(1, '#2a6cf0')
      ctx.fillStyle = g
      ctx.beginPath()
      const r = 16
      ctx.moveTo(r, 0)
      ctx.arcTo(canvas.width, 0, canvas.width, canvas.height, r)
      ctx.arcTo(canvas.width, canvas.height, 0, canvas.height, r)
      ctx.arcTo(0, canvas.height, 0, 0, r)
      ctx.arcTo(0, 0, canvas.width, 0, r)
      ctx.closePath()
      ctx.fill()
      ctx.fillStyle = '#0f1115'
      ctx.font = '20px sans-serif'
      ctx.fillText('canvas', 16, 36)
    </script>
  </layer>
  <layer x="296" y="200">
    <p style="font-size:20px; color:#9aa3b2">canvas 渐变块</p>
  </layer>
  <layer width="160" height="160" x="536" y="208">
    <canvas id="rays" width="160" height="160"></canvas>
    <script>
      const canvas = document.querySelector('#rays')
      const ctx = canvas.getContext('2d')
      const cx = canvas.width / 2
      const cy = canvas.height / 2
      const rays = 16
      for (let i = 0; i < rays; i++) {
        const a0 = (i / rays) * Math.PI * 2
        const a1 = ((i + 0.45) / rays) * Math.PI * 2
        ctx.beginPath()
        ctx.moveTo(cx, cy)
        ctx.arc(cx, cy, 70, a0, a1)
        ctx.closePath()
        ctx.fillStyle = i % 2 === 0 ? '#f5c16c' : '#e8894a'
        ctx.fill()
      }
      ctx.beginPath()
      ctx.arc(cx, cy, 28, 0, Math.PI * 2)
      ctx.fillStyle = '#0f1115'
      ctx.fill()
    </script>
  </layer>
</layer>
