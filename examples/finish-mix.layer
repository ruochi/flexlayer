<layer width="1760" height="820" background="#12141a" color="#f4efe6" font-family="ChillDuanSans" safe="0">
  <layer camera="1600" width="1760" height="820">
    <ground y="620" rotateX="74" fill="#22252e" />

    <rect x="72" y="340" width="200" height="160" depth="160" rx="8" fill="#d9d3c7" rotateY="-18" />
    <sphere cx="430" cy="434" r="86" fill="#c45a3a" material="clay" />
    <sphere cx="640" cy="476" r="44" fill="#f3f1ec" material="plastic 0.22" />
    <circle cx="820" cy="400" r="46" depth="240" fill="#eef3f8" material="glass 0.1" rotateX="90" />
    <rect x="940" y="390" width="190" height="120" depth="100" rx="24" fill="#2a6fbe" material="plastic" rotateY="24" rotateX="-8" />
    <sphere cx="1260" cy="464" r="56" fill="#8b939c" material="metal 0.72" />
    <circle cx="1450" cy="390" r="50" depth="260" fill="#c86a3e" material="brushed" rotateX="90" />
    <sphere cx="1640" cy="442" r="78" fill="#e4b33a" material="mirror" />
  </layer>

  <layer x="64" y="32" anchor-box="ink">
    <p style="font-size:40px">一张桌子</p>
  </layer>
  <layer x="64" y="88">
    <p style="font-size:28px; color:#c8c2b6">陶土、塑料盒、拉丝、镜面是材质球，其余沿用原来的着色</p>
  </layer>

  <layer x="100" y="740" width="140"><p style="font-size:26px; color:#c8c2b6">磨砂</p></layer>
  <layer x="370" y="740" width="120"><p style="font-size:26px; color:#c8c2b6">clay</p></layer>
  <layer x="540" y="740" width="190"><p style="font-size:26px; color:#c8c2b6">plastic 0.22</p></layer>
  <layer x="740" y="740" width="160"><p style="font-size:26px; color:#c8c2b6">glass 0.1</p></layer>
  <layer x="980" y="740" width="140"><p style="font-size:26px; color:#c8c2b6">plastic</p></layer>
  <layer x="1160" y="740" width="180"><p style="font-size:26px; color:#c8c2b6">metal 0.72</p></layer>
  <layer x="1370" y="740" width="150"><p style="font-size:26px; color:#c8c2b6">brushed</p></layer>
  <layer x="1560" y="740" width="140"><p style="font-size:26px; color:#c8c2b6">mirror</p></layer>
</layer>
