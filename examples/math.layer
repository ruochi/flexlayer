<layer width="900" height="1130" background="#ffffff" color="#111111">
  <layer x="48" y="40">
    <div style="display:flex; flex-direction:column; align-items:flex-start; gap:30px">
      <div style="display:flex; gap:16px; align-items:center"><span>高斯积分</span>
        <math display="block"><msubsup><mo>∫</mo><mrow><mo>-</mo><mi>∞</mi></mrow><mi>∞</mi></msubsup><msup><mi>e</mi><mrow><mo>-</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></msup><mi>d</mi><mi>x</mi><mo>=</mo><msqrt><mi>π</mi></msqrt></math>
      </div>
      <div style="display:flex; gap:16px; align-items:center"><span>巴塞尔</span>
        <math display="block"><munderover><mo>∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>∞</mi></munderover><mfrac><mn>1</mn><msup><mi>n</mi><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><msup><mi>π</mi><mn>2</mn></msup><mn>6</mn></mfrac></math>
      </div>
      <div style="display:flex; gap:16px; align-items:center"><span>分段</span>
        <math display="block"><mi>f</mi><mo>(</mo><mi>x</mi><mo>)</mo><mo>=</mo><mrow><mo>{</mo><mtable columnalign="left"><mtr><mtd><msup><mi>x</mi><mn>2</mn></msup></mtd><mtd><mtext>当 </mtext><mi>x</mi><mo>≥</mo><mn>0</mn></mtd></mtr><mtr><mtd><mo>-</mo><mi>x</mi></mtd><mtd><mtext>否则</mtext></mtd></mtr></mtable></mrow></math>
      </div>
      <div style="display:flex; gap:16px; align-items:center"><span>连分数</span>
        <math display="block"><mi>x</mi><mo>=</mo><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mi>x</mi></mfrac></mrow></mfrac></mrow></mfrac><mo>,</mo><mrow><mo>(</mo><mfrac linethickness="0"><mi>n</mi><mi>k</mi></mfrac><mo>)</mo></mrow><mo>,</mo><mrow><mo>[</mo><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>]</mo></mrow></math>
      </div>
      <div style="display:flex; gap:16px; align-items:center"><span>重音</span>
        <math><mover><mi>x</mi><mo>^</mo></mover><mo>,</mo><mover><mi>v</mi><mo>→</mo></mover><mo>,</mo><mover><mrow><mi>A</mi><mi>B</mi></mrow><mo>→</mo></mover><mo>,</mo><mover><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>¯</mo></mover><mo>,</mo><mover><mi>y</mi><mo>~</mo></mover><mo>,</mo><mi mathvariant="double-struck">R</mi><mo>∈</mo><msup><mi mathvariant="bold">v</mi><mi>T</mi></msup><mo>,</mo><mover><mrow><mi>x</mi><mo>+</mo><mi>y</mi><mo>+</mo><mi>z</mi></mrow><mo>⏞</mo></mover></math>
      </div>
      <div style="display:flex; gap:16px; align-items:center"><span>矩阵</span>
        <math display="block"><mi mathvariant="bold">A</mi><mo>=</mo><mrow><mo>[</mo><mtable><mtr><mtd><msub><mi>a</mi><mn>11</mn></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>a</mi><mrow><mn>1</mn><mi>n</mi></mrow></msub></mtd></mtr><mtr><mtd><mo>⋮</mo></mtd><mtd><mo>⋱</mo></mtd><mtd><mo>⋮</mo></mtd></mtr><mtr><mtd><msub><mi>a</mi><mrow><mi>m</mi><mn>1</mn></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>a</mi><mrow><mi>m</mi><mi>n</mi></mrow></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo><mrow><mo>|</mo><mi>x</mi><mo>|</mo></mrow><mo>,</mo><mrow><mo>|</mo><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>|</mo></mrow></math>
      </div>
      <div style="display:flex; gap:16px; align-items:center"><span>行内</span>
        <math><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mfrac><mi>a</mi><mi>b</mi></mfrac><mo>,</mo><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><mi>f</mi><mo>,</mo><msup><mi>f</mi><mo>′</mo></msup><mo>(</mo><mi>x</mi><mo>)</mo></math>
        <span>和正文对齐 xyz</span>
      </div>
    </div>
  </layer>
</layer>
