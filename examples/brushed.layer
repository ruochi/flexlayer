<layer width="1400" height="760" background="#101114" color="#f4efe6" font-family="ChillDuanSans">
  <layer camera="1600" width="1400" height="760">
    <sphere cx="200" cy="230" r="88" material="brushed" />
    <circle cx="620" cy="250" r="70" depth="220" material="brushed" rotateX="90" />

    <sphere cx="200" cy="560" r="88" fill="#c86a3e" material="brushed" />
    <circle cx="620" cy="530" r="70" depth="220" fill="#c86a3e" material="brushed" rotateX="90" />

    <ground y="700" rotateX="72" fill="#181a20" />
  </layer>
  <layer x="900" y="60" width="440" height="640" camera="420">
    <rect x="80" y="80" width="280" height="180" depth="14" rx="7" material="brushed" rotateX="10" rotateY="-15" />
    <rect x="80" y="400" width="280" height="180" depth="14" rx="7" fill="#c86a3e" material="brushed" rotateX="10" rotateY="-15" />
    <ground y="640" rotateX="72" />
  </layer>
  <layer x="72" y="28">
    <p style="font-size:32px">brushed · 纹路沿局部 x，高光与纹路垂直</p>
  </layer>
  <layer x="140" y="340" width="120"><p style="font-size:24px; color:#c8c2b6">球</p></layer>
  <layer x="540" y="390" width="160"><p style="font-size:24px; color:#c8c2b6">圆柱</p></layer>
  <layer x="1080" y="340" width="160"><p style="font-size:24px; color:#c8c2b6">平板</p></layer>
</layer>
