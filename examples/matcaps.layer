<layer width="1400" height="760" background="#101114" color="#f4efe6" font-family="ChillDuanSans">
  <layer camera="1600" width="1400" height="760">
    <sphere cx="160" cy="250" r="88" material="clay" />
    <sphere cx="430" cy="250" r="88" material="plastic" />
    <sphere cx="700" cy="250" r="88" material="metal" />
    <sphere cx="970" cy="250" r="88" material="mirror" />
    <sphere cx="1240" cy="250" r="88" material="brushed" />

    <sphere cx="160" cy="560" r="88" fill="#c45a3a" material="clay" />
    <sphere cx="430" cy="560" r="88" fill="#2a6fbe" material="plastic" />
    <sphere cx="700" cy="560" r="88" fill="#e4b33a" material="metal" />
    <sphere cx="970" cy="560" r="88" fill="#e4b33a" material="mirror" />
    <sphere cx="1240" cy="560" r="88" fill="#c86a3e" material="brushed" />

    <ground y="680" rotateX="72" fill="#181a20" />
  </layer>
  <layer x="72" y="28">
    <p style="font-size:32px">clay · plastic · metal · mirror · brushed</p>
  </layer>
  <layer x="96" y="360" width="128"><p style="font-size:24px; color:#c8c2b6">clay</p></layer>
  <layer x="350" y="360" width="160"><p style="font-size:24px; color:#c8c2b6">plastic</p></layer>
  <layer x="636" y="360" width="128"><p style="font-size:24px; color:#c8c2b6">metal</p></layer>
  <layer x="900" y="360" width="140"><p style="font-size:24px; color:#c8c2b6">mirror</p></layer>
  <layer x="1164" y="360" width="150"><p style="font-size:24px; color:#c8c2b6">brushed</p></layer>
</layer>
