<layer width="640" height="470" background="#0c1424" color="#f4ecdf" safe="0">
  <!-- A camera study: one stage, two shots of it. The left cell is the wide
       shot with the camera layer's own `view`; the right cell is the same stage
       seen from a different orbit. Both are 3D now, so the plate shows what the
       camera attributes do rather than a flat circle on a dark page (§C.1). -->
  <layer x="24" y="16"><p style="font-size:26px; white-space:nowrap">同一舞台 · 两个机位</p></layer>

  <layer x="24" y="64" width="288" height="352">
    <layer width="288" height="352" camera="fov 32, orbit 18 24, distance 700, at 144 300 0">
      <ground y="290" rotateX="90" fill="#1c3148" shadow-blur="44" shadow-opacity="0.32" />
      <layer x="0" y="290" width="288" height="240" origin="144 0" rotateX="90" preserve-3d>
        <!-- Separate the two bodies so a shared silhouette does not read as a seam. -->
        <sphere cx="70" cy="100" r="48" z="48" fill="#e8b04a" material="plastic 0.28" />
        <rect x="155" y="70" width="90" height="90" depth="90" rx="14" z="45" fill="#d23b3b" material="plastic 0.34" />
      </layer>
    </layer>
  </layer>

  <layer x="328" y="64" width="288" height="352">
    <layer width="288" height="352" camera="fov 32, orbit 52 34, distance 560, at 144 300 0">
      <ground y="290" rotateX="90" fill="#1c3148" shadow-blur="44" shadow-opacity="0.32" />
      <layer x="0" y="290" width="288" height="240" origin="144 0" rotateX="90" preserve-3d>
        <sphere cx="70" cy="100" r="48" z="48" fill="#e8b04a" material="plastic 0.28" />
        <rect x="155" y="70" width="90" height="90" depth="90" rx="14" z="45" fill="#d23b3b" material="plastic 0.34" />
      </layer>
    </layer>
  </layer>

  <layer x="24" y="424" width="288"><p style="font-size:22px; color:#a9b6c6">orbit 18 24 · distance 700</p></layer>
  <layer x="328" y="424" width="288"><p style="font-size:22px; color:#a9b6c6">orbit 52 34 · distance 560</p></layer>
</layer>
