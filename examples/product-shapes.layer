<layer width="1280" height="760" background="#241f1b" color="#f6f2e9" font-family="ChillDuanSans" safe="0">
  <layer x="64" y="40">
    <p style="font-size:40px">圆角矩形 · 圆柱 · 圆管</p>
  </layer>
  <layer x="64" y="96">
    <p style="font-size:24px; color:#b3a996">同一套材质、同一束光，接触阴影落在同一块地面上</p>
  </layer>

  <layer camera="fov 30, orbit 24 30, distance 1400, at 640 620 0" width="1280" height="760">
    <ground y="470" rotateX="90" fill="#e7e0d4" shadow-blur="38" shadow-opacity="0.5" />
    <layer x="0" y="470" width="1280" height="560" origin="640 0" rotateX="90" preserve-3d>
      <rect x="340" y="120" width="120" height="250" depth="110" rx="30" z="55" fill="#2c2f36" material="plastic 0.3" rotateY="24" />
      <rect x="560" y="140" width="200" height="210" depth="86" rx="22" z="43" fill="#c9a24a" material="metal 0.3" rotateY="44" rotateX="10" />
      <!-- Upright on a rotateX=90 floor: `circle depth` is Z-axis (§C / §D). -->
      <circle cx="910" cy="250" r="72" depth="230" z="115" fill="#4CC3D9" material="metal 0.28" />
      <circle cx="750" cy="450" r="58" depth="130" z="65" fill="#2c2f36" material="metal 0.36" />
      <tube d="M1040 450 C1040 350 1110 315 1160 315" r="18" z="18" fill="#c2543f" material="plastic 0.3" rotateX="48" />
    </layer>
  </layer>

  <layer x="340" y="560" width="120">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:120px">
      <p style="font-size:26px">圆角矩形</p>
      <p style="font-size:22px; color:#b3a996">塑料</p>
    </div>
  </layer>
  <layer x="560" y="560" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:200px">
      <p style="font-size:26px">圆角矩形</p>
      <p style="font-size:22px; color:#b3a996">金属 · 斜置</p>
    </div>
  </layer>
  <layer x="695" y="560" width="110">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:110px">
      <p style="font-size:26px">扁圆柱</p>
      <p style="font-size:22px; color:#b3a996">rx 24</p>
    </div>
  </layer>
  <layer x="850" y="560" width="120">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:120px">
      <p style="font-size:26px">圆柱</p>
      <p style="font-size:22px; color:#b3a996">金属</p>
    </div>
  </layer>
  <layer x="1040" y="560" width="240">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:260px">
      <p style="font-size:26px">圆管</p>
      <p style="font-size:22px; color:#b3a996">沿三维曲线扫掠</p>
    </div>
  </layer>
</layer>
