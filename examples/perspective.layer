<layer width="880" height="600" background="#0f1115" camera="fov 30, orbit 22 26, distance 1100, at 440 560 0">
  <!-- QUALITY-6 §C.2: `depth` is centred on the plate's own plane, so a plate
       standing on the floor needs `z` equal to half its depth (§D); at `z="0"`
       the floor cuts it in half and there is no contact shadow to read. -->
  <ground y="530" rotateX="90" fill="#d9dee7" shadow-blur="34" shadow-opacity="0.6" />
  <layer x="0" y="530" width="880" height="400" origin="440 0" rotateX="90" preserve-3d>
    <!-- Two plates, both turned the same way, standing on the same floor. One
         camera is what makes their far edges converge on one vanishing point;
         `mesh.spec.ts` pins that. The cyan plate is turned away on its right
         edge, so that edge is shorter than its left one. -->
    <rect x="250" y="60" width="200" height="230" depth="26" z="13" fill="#4CC3D9" rotateY="28" />
    <rect x="580" y="60" width="160" height="200" depth="26" z="13" fill="#EF2D5E" rotateY="28" />
  </layer>
</layer>
