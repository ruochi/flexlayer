<layer width="960" height="600" background="#241f1b" camera="fov 30, orbit 28 32, distance 1250, at 480 560 0">
  <!-- QUALITY-6 §C.2: `depth` is centered on the shape's plane, so a box on the
       floor needs `z` equal to half its depth, a sphere `z` equal to its radius,
       and a torus `z` equal to its tube. Otherwise the floor plane cuts the
       body in half and there is no contact shadow to read (§D). -->
  <ground y="470" rotateX="90" fill="#e7e0d4" shadow-blur="40" shadow-opacity="0.5" />
  <layer x="0" y="470" width="960" height="400" origin="480 0" rotateX="90" preserve-3d>
    <cylinder cx="240" cy="110" r="60" height="190" z="95" fill="#e8b04a" rotateY="-26" />
    <torus cx="490" cy="100" r="78" tube="21" z="21" fill="#4CC3D9" rotateX="64" />
    <tube d="M620 170 C656 170 654 46 720 46 C780 46 776 160 830 122" r="14" fill="#EF2D5E" rotateX="48" z="14" />
  </layer>
</layer>
