<layer width="960" height="600" background="#241f1b" camera="fov 30, orbit 28 32, distance 1250, at 480 560 0" quality="final">
  <!-- QUALITY-6 §C.2: `depth` is centered on the shape's plane, so a box on the
       floor needs `z` equal to half its depth, a sphere `z` equal to its radius,
       and a torus `z` equal to its tube. Otherwise the floor plane cuts the
       body in half and there is no contact shadow to read (§D). -->
  <ground y="470" rotateX="90" fill="#e7e0d4" shadow-blur="48" shadow-opacity="0.38" />
  <layer x="0" y="470" width="960" height="400" origin="480 0" rotateX="90" preserve-3d>
    <!-- `circle depth` is a Z-axis cylinder: after the floor's rotateX=90 that
         axis stands up. A Y-axis `<cylinder>` would lie on the floor as a log
         and read as floating/faceted from this orbit. -->
    <circle cx="220" cy="160" r="58" depth="160" z="80" fill="#e8b04a" material="plastic 0.28" />
    <torus cx="480" cy="150" r="78" tube="22" z="22" fill="#4CC3D9" material="plastic 0.34" rotateX="58" />
    <tube d="M620 200 C660 200 658 90 720 90 C780 90 778 190 830 160" r="16" fill="#EF2D5E" material="plastic 0.28" rotateX="40" z="16" />
  </layer>
</layer>
