<layer width="1520" height="1080" background="#101114" color="#f4efe6" font-family="ChillDuanSans">
  <layer x="64" y="24">
    <p style="font-size:40px">金银铜铁 · 塑料</p>
  </layer>

  <layer perspective="1600" width="1520" height="1080">
    <sphere cx="230" cy="220" r="84" fill="#e4b33a" material="metal 0.08" />
    <sphere cx="570" cy="220" r="84" fill="#d5d8e0" material="metal 0.08" />
    <sphere cx="910" cy="220" r="84" fill="#c86a3e" material="metal 0.08" />
    <sphere cx="1250" cy="220" r="84" fill="#8b939c" material="metal 0.08" />

    <sphere cx="230" cy="548" r="84" fill="#e4b33a" material="metal 0.82" />
    <sphere cx="570" cy="548" r="84" fill="#d5d8e0" material="metal 0.82" />
    <sphere cx="910" cy="548" r="84" fill="#c86a3e" material="metal 0.82" />
    <sphere cx="1250" cy="548" r="84" fill="#8b939c" material="metal 0.82" />

    <sphere cx="160" cy="880" r="62" fill="#f3f1ec" material="plastic 0.12" />
    <sphere cx="390" cy="880" r="62" fill="#d23b3b" material="plastic 0.28" />
    <sphere cx="620" cy="880" r="62" fill="#2a6fbe" material="plastic 0.44" />
    <sphere cx="850" cy="880" r="62" fill="#248f62" material="plastic 0.6" />
    <sphere cx="1080" cy="880" r="62" fill="#e0b03a" material="plastic 0.76" />
    <sphere cx="1310" cy="880" r="62" fill="#6d4a9a" material="plastic 0.92" />
  </layer>

  <layer x="64" y="84">
