      <p style="font-size:32px">铁</p>
      <p style="font-size:28px; color:#9a9488">#8b939c</p>
    </div>
  </layer>

  <layer x="64" y="748">
    <p style="font-size:28px; color:#c8c2b6">塑料 · 粗糙从 0.12 到 0.92</p>
  </layer>
  <layer x="60" y="860" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:200px">
      <p style="font-size:32px">白</p>
      <p style="font-size:28px; color:#9a9488">0.12</p>
    </div>
  </layer>
  <layer x="290" y="860" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:200px">
      <p style="font-size:32px">红</p>
      <p style="font-size:28px; color:#9a9488">0.28</p>
    </div>
  </layer>
  <layer x="520" y="860" width="200">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:200px">
      <p style="font-size:32px">蓝</p>
      <p style="font-size:28px; color:#9a9488">0.44</p>
