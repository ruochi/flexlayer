<layer width="1520" height="1080" background="#101114" color="#f4efe6" font-family="ChillDuanSans" safe="0">
  <layer x="64" y="24">
    <p style="font-size:40px">金银铜铁 · 塑料</p>
  </layer>

  <!-- QUALITY-6 §C.2: every sphere sits on the floor, so `z` equals its radius.
       Without it the ground plane cuts the sphere in half (§D) and there is no
       contact shadow under it. -->
  <layer camera="fov 30, orbit 4 22, distance 2600, at 760 760 0" width="1520" height="1080">
    <ground y="700" rotateX="90" fill="#3c414c" shadow-blur="36" shadow-opacity="0.55" />
    <layer x="0" y="700" width="1520" height="700" origin="760 0" rotateX="90" preserve-3d>
      <sphere cx="230" cy="150" r="84" z="84" fill="#e4b33a" material="metal 0.08" />
      <sphere cx="570" cy="150" r="84" z="84" fill="#d5d8e0" material="metal 0.08" />
      <sphere cx="910" cy="150" r="84" z="84" fill="#c86a3e" material="metal 0.08" />
      <sphere cx="1250" cy="150" r="84" z="84" fill="#8b939c" material="metal 0.08" />

      <sphere cx="230" cy="420" r="84" z="84" fill="#e4b33a" material="metal 0.82" />
      <sphere cx="570" cy="420" r="84" z="84" fill="#d5d8e0" material="metal 0.82" />
      <sphere cx="910" cy="420" r="84" z="84" fill="#c86a3e" material="metal 0.82" />
      <sphere cx="1250" cy="420" r="84" z="84" fill="#8b939c" material="metal 0.82" />

      <sphere cx="160" cy="690" r="62" z="62" fill="#f3f1ec" material="plastic 0.12" />
      <sphere cx="390" cy="690" r="62" z="62" fill="#d23b3b" material="plastic 0.28" />
      <sphere cx="620" cy="690" r="62" z="62" fill="#2a6fbe" material="plastic 0.44" />
      <sphere cx="850" cy="690" r="62" z="62" fill="#248f62" material="plastic 0.6" />
      <sphere cx="1080" cy="690" r="62" z="62" fill="#e0b03a" material="plastic 0.76" />
      <sphere cx="1310" cy="690" r="62" z="62" fill="#6d4a9a" material="plastic 0.92" />
    </layer>
  </layer>

  <layer x="64" y="84">
    <p style="font-size:28px; color:#c8c2b6">金属 · 粗糙 0.08</p>
  </layer>
  <layer x="120" y="316" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">金</p>
      <p style="font-size:28px; color:#9a9488">#e4b33a</p>
    </div>
  </layer>
  <layer x="460" y="316" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">银</p>
      <p style="font-size:28px; color:#9a9488">#d5d8e0</p>
    </div>
  </layer>
  <layer x="800" y="316" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">铜</p>
      <p style="font-size:28px; color:#9a9488">#c86a3e</p>
    </div>
  </layer>
  <layer x="1140" y="316" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">铁</p>
      <p style="font-size:28px; color:#9a9488">#8b939c</p>
    </div>
  </layer>

  <layer x="64" y="420">
    <p style="font-size:28px; color:#c8c2b6">金属 · 粗糙 0.82</p>
  </layer>
  <layer x="120" y="586" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">金</p>
      <p style="font-size:28px; color:#9a9488">#e4b33a</p>
    </div>
  </layer>
  <layer x="460" y="586" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">银</p>
      <p style="font-size:28px; color:#9a9488">#d5d8e0</p>
    </div>
  </layer>
  <layer x="800" y="586" width="220">
    <div style="display:flex; flex-direction:column; align-items:center; gap:4px; width:220px">
      <p style="font-size:32px">铜</p>
      <p style="font-size:28px; color:#9a9488">#c86a3e</p>
    </div>
  </layer>
  <layer x="1140" y="586" width="220">
