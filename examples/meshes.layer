<layer width="960" height="640" background="#f3efe6" camera="fov 30, orbit 26 30, distance 1150, at 480 460 0">
  <!-- Soft contact: a hard 34px ring read as a black collar around every base. -->
  <ground y="500" rotateX="90" fill="#e7e0d4" shadow-blur="52" shadow-opacity="0.32" />
  <layer x="0" y="500" width="960" height="380" origin="480 0" rotateX="90" preserve-3d>
    <sphere cx="150" cy="150" r="72" z="72" fill="#4CC3D9" material="plastic 0.4" />
    <rect x="300" y="120" width="150" height="100" depth="72" rx="8" z="36" fill="#EF2D5E" material="plastic 0.34" />
    <path d="M530 150 H670 V186 H620 V230 H530 Z" depth="26" z="13" fill="#f4f1ea" material="matte" />
    <model src="box.glb" x="720" y="60" width="110" height="110" material="metal 0.28" />
  </layer>
</layer>
