<layer width="1200" height="700" background="#10141c" camera="1100">
  <layer x="180" y="170" width="260" height="360" rotateY="34" z="-60">
    <rect x="0" y="0" width="260" height="360" rx="22" fill="#31425c" />
    <layer x="32" y="48" anchor-box="ink">
      <h2 style="font-size:40px; color:#f4f1ea">Left</h2>
    </layer>
  </layer>
  <layer id="card" x="470" y="140" width="260" height="400" rotateY="-4" z="90">
    <rect x="0" y="0" width="260" height="400" rx="22" fill="#f3efe6" />
    <layer x="32" y="48" anchor-box="ink">
      <h2 style="font-size:44px; color:#1a1408">Focus</h2>
    </layer>
  </layer>
  <layer x="760" y="170" width="260" height="360" rotateY="-34" z="-60">
    <rect x="0" y="0" width="260" height="360" rx="22" fill="#1f6f78" />
    <layer x="32" y="48" anchor-box="ink">
      <h2 style="font-size:40px; color:#f4f1ea">Right</h2>
    </layer>
  </layer>
</layer>
